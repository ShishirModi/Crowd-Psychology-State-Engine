# Copy this file to .env and fill in your actual values.
# The backend reads these on startup via python-dotenv.

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production

# ── TomTom Traffic API (optional — falls back to simulation if absent) ────────
TOMTOM_API_KEY=your_tomtom_api_key_here

# ── OpenWeatherMap API (optional) ─────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# ── Seed users (comma-separated passwords; first = admin) ─────────────────────
APP_PASSWORD=cpseisawesome,viewer2password
