# ── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# The app reads these on startup via python-dotenv.

NEON_PASS=your_neon_db_password_here

# ── TomTom Traffic API (optional — app falls back to simulation if absent) ───
TOMTOM_API_KEY=your_tomtom_api_key_here

# ── OpenWeatherMap API (optional) ────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# ── App access password (optional — defaults to "cpseisawesome") ─────────────
# APP_PASSWORD=your_dashboard_password
